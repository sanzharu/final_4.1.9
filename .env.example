# =============================================================================
# .env.example — Literary Haven
#
# Скопируйте в .env и заполните перед деплоем:
#   cp .env.example .env
#
# Генерация случайных ключей:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# НИКОГДА не коммитьте .env в git — он в .gitignore.
# =============================================================================

# ── Домен (без https://, без слэша в конце) ───────────────────────────────────
# Пример: yourdomain.ru  или  sub.yourdomain.com
# Именно этот домен должен указывать A-записью на IP вашего сервера.
DOMAIN=yourdomain.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=lhuser
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password_here
POSTGRES_DB=literaryhaven

# ── JWT секреты — сгенерируйте новые для каждого окружения ────────────────────
SECRET_KEY=CHANGE_ME_run_python_c_import_secrets_print_secrets_token_hex_32
REFRESH_SECRET_KEY=CHANGE_ME_another_key_run_python_c_import_secrets_print_secrets_token_hex_32

# ── Uvicorn ───────────────────────────────────────────────────────────────────
# Рекомендация: количество CPU × 2. На VPS с 1 CPU используйте 2.
UVICORN_WORKERS=2

# ── OAuth (необязательно — оставьте пустым чтобы отключить провайдера) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
