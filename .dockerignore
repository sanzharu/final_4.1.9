# ── Version control ──────────────────────────────────────────────────────────
.git
.gitignore

# ── Data files (large datasets / long Cyrillic filenames crash overlayfs) ────
# Books/poems data is seeded at runtime from the DB or seed scripts,
# NOT baked into the image.
data/

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Tests & coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
tests/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
*.pem
*.key
*.crt

# ── Claude Code ──────────────────────────────────────────────────────────────
.claude/
